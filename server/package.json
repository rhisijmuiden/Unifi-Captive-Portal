{
  "name": "@captive-portal/server",
  "version": "0.7.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "basic-ftp": "^6.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.8",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "svg-to-pdfkit": "^0.1.8",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "@types/svg-to-pdfkit": "^0.1.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
