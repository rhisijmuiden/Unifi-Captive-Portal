# Copy to .env for local development. The installer writes /etc/captive-portal/captive-portal.env.
DATABASE_URL=postgres://captive:captive@localhost:5432/captive
# 32+ random bytes, used to sign sessions and encrypt stored secrets (SMTP/SSO passwords)
APP_SECRET=change-me-to-a-long-random-string
PORT=8080
HOST=0.0.0.0
# Public URL of the admin panel, used in e-mails and as SSO redirect base
PUBLIC_URL=http://localhost:8080
# Directory for runtime state (update requests, backups, uploads)
DATA_DIR=./data
# GitHub repository used for update checks
UPDATE_REPO=rhisijmuiden/Unifi-Captive-Portal
NODE_ENV=development
