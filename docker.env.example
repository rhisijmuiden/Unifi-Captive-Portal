# Copy to docker.env and fill in. Used by: docker compose --env-file docker.env up -d --build
# Signs sessions and encrypts stored secrets. Create one with: openssl rand -hex 32
APP_SECRET=
# Address of the admin panel as people reach it; used in e-mails and links
PUBLIC_URL=http://192.0.2.10:8080
# Database password (only used between the two containers)
DB_PASSWORD=change-me
# Ports on the host
ADMIN_PORT=8080
GUEST_PORT=80
MAILPIT_PORT=8025
# Start Mailpit too, to catch e-mails instead of sending them (remove the line to send real mail)
COMPOSE_PROFILES=mailpit
